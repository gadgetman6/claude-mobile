# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# VAPID keys for push notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

# APNs keys for iOS push notifications
# - Create an APNs Auth Key (.p8) in Apple Developer → Certificates, Identifiers & Profiles → Keys
# - Store the .p8 file outside the repo (it's ignored by git)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
APNS_TOPIC=
APNS_PRODUCTION=false

# Server config
PORT=3333
HOST=0.0.0.0
